digraph "SaveData"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="SaveData",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Represents a snapshot of the game state for saving."];
  Node2 -> Node1 [id="edge3_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" hero_snapshot",fontcolor="grey" ];
  Node2 [id="Node000002",label="Hero",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structHero.html",tooltip="This is for the hero's inventory and statistics."];
  Node3 -> Node1 [id="edge4_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" mission_snapshot",fontcolor="grey" ];
  Node3 [id="Node000003",label="MissionStatus",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structMissionStatus.html",tooltip="Used for tracking the progress of a specific mission."];
}
