digraph "SaveNode"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="SaveNode",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Node for the linked list of saved games."];
  Node2 -> Node1 [id="edge5_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" data",fontcolor="grey" ];
  Node2 [id="Node000002",label="SaveData",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structSaveData.html",tooltip="Represents a snapshot of the game state for saving."];
  Node3 -> Node2 [id="edge6_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" hero_snapshot",fontcolor="grey" ];
  Node3 [id="Node000003",label="Hero",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structHero.html",tooltip="This is for the hero's inventory and statistics."];
  Node4 -> Node2 [id="edge7_Node000002_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" mission_snapshot",fontcolor="grey" ];
  Node4 [id="Node000004",label="MissionStatus",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structMissionStatus.html",tooltip="Used for tracking the progress of a specific mission."];
  Node1 -> Node1 [id="edge8_Node000001_Node000001",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" next",fontcolor="grey" ];
}
