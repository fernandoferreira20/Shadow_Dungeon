digraph "GameData"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="GameData",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="The master game structure holding the active state."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" current_hero",fontcolor="grey" ];
  Node2 [id="Node000002",label="Hero",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structHero.html",tooltip="This is for the hero's inventory and statistics."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" missions",fontcolor="grey" ];
  Node3 [id="Node000003",label="MissionStatus",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structMissionStatus.html",tooltip="Used for tracking the progress of a specific mission."];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" save_list_head",fontcolor="grey" ];
  Node4 [id="Node000004",label="SaveNode",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structSaveNode.html",tooltip="Node for the linked list of saved games."];
  Node5 -> Node4 [id="edge4_Node000004_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" data",fontcolor="grey" ];
  Node5 [id="Node000005",label="SaveData",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structSaveData.html",tooltip="Represents a snapshot of the game state for saving."];
  Node2 -> Node5 [id="edge5_Node000005_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" hero_snapshot",fontcolor="grey" ];
  Node3 -> Node5 [id="edge6_Node000005_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" mission_snapshot",fontcolor="grey" ];
  Node4 -> Node4 [id="edge7_Node000004_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" next",fontcolor="grey" ];
}
